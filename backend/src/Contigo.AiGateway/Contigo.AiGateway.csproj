<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Contigo.SharedKernel\Contigo.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task E02/F01/US02/T01: this module's own AddAiGatewayModule(IServiceCollection)
         composition-root wiring (ServiceCollectionExtensions.cs) — ADR-002's "each module
         exposes an AddXxx(IServiceCollection) extension method", not yet done when this project
         was created because no host took a dependency on IAiGateway yet
         (AiGatewayModelOptions's own doc comment names this task as "the first caller"). These
         are generic .NET hosting/config abstractions, not a provider SDK, so they do not trip
         Contigo.ArchitectureTests.DependencyDirectionTests.Domain_module_must_not_reference_provider_sdks
         (Worker already references the same-family Microsoft.Extensions.Hosting for the same
         reason). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
