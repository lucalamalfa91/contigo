<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Contigo.Api\Contigo.Api.csproj" />
    <ProjectReference Include="..\..\src\Contigo.Identity.Workspace\Contigo.Identity.Workspace.csproj" />
    <ProjectReference Include="..\..\src\Contigo.Documents.Contracts\Contigo.Documents.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Contigo.Audit\Contigo.Audit.csproj" />
    <ProjectReference Include="..\..\src\Contigo.SharedKernel\Contigo.SharedKernel.csproj" />
    <!-- Task E02/F04/US02/T01: AskContigoRagCrossTenantIsolationTests composes
         EmbeddingRetrievalService (Documents.Contracts, already referenced above) with the real
         POST /api/chat/query host (Contigo.Api, which already references both of these
         transitively) — explicit here for the same directness every other reference in this file
         already has, not because compilation would fail without it. -->
    <ProjectReference Include="..\..\src\Contigo.Chat\Contigo.Chat.csproj" />
    <ProjectReference Include="..\..\src\Contigo.AiGateway\Contigo.AiGateway.csproj" />
    <!-- Task E03/F04/US01/T01 (r2-integration): R2EndToEndTests/R2CrossTenantIsolationTests
         resolve Contigo.Renewals.Application types (RenewalThresholdScheduler, ContractRenewalTerms,
         RenewalActionService, RenewalMilestoneKind, ...) directly from the host's own container and
         construct DTOs by hand — Contigo.Api already references this module transitively, but a
         test file needs the compile-time type names, not just the transitive runtime assembly. -->
    <ProjectReference Include="..\..\src\Contigo.Renewals\Contigo.Renewals.csproj" />
    <!-- Task E04/F04/US01/T01 (r3-integration): R3EndToEndTests/R3CrossTenantIsolationTests resolve
         Contigo.Savings.Application/Domain types (SavingsOpportunityService,
         CreateSavingsOpportunityRequest, SavingsOpportunityStatus, ...) and Contigo.Benchmark.Contracts/
         Adapters types (IBenchmarkService, BenchmarkQuery, IBenchmarkProviderAdapter,
         FixtureBenchmarkAdapter, ...) directly from the host's own container and construct DTOs by
         hand — same "Contigo.Api already references this transitively, but a test file needs the
         compile-time type names" reasoning as the Contigo.Renewals reference just above. -->
    <ProjectReference Include="..\..\src\Contigo.Savings\Contigo.Savings.csproj" />
    <ProjectReference Include="..\..\src\Contigo.Benchmark\Contigo.Benchmark.csproj" />
    <!-- Task E05/F01/US01/T01 (quote-extraction): QuoteEndToEndTests resolves
         Contigo.Quotes.Infrastructure.QuotesDbContext directly from the host's own container to
         assert on persisted QuoteLine rows (evidence/confidence, AC-2) — same "Contigo.Api already
         references this transitively, but a test file needs the compile-time type names" reasoning
         as the Contigo.Savings/Contigo.Renewals references above. -->
    <ProjectReference Include="..\..\src\Contigo.Quotes\Contigo.Quotes.csproj" />
  </ItemGroup>

</Project>
